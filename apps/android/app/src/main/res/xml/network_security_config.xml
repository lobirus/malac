<?xml version="1.0" encoding="utf-8"?>
<!-- A daemon on the local network or a VPN speaks plain HTTP at an address
     only the user knows, so cleartext cannot be limited to a list of hosts.
     Tunnels and reverse proxies use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
